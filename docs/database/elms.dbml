// =============================================================================
// Enterprise License Management System (ELMS) - team VFast
// Database design (DBML) - design status: TARGET, nothing implemented yet
//
// Sources: README.md, docs/01-research-top-down.md, docs/02-use-cases.md
//          (November 2026),
//          docs/08-feature-list.md.
// UCxx / BR-xx / Ax in the notes refer to those documents. Dxx refers to the
// decisions below; docs/database/README.md explains each one.
//
// Render: paste into https://dbdiagram.io or run `npx -p @dbml/cli dbml2sql
//         docs/database/elms.dbml --postgres` (validated with @dbml/cli 12.0.0).
//         Reference DDL: docs/database/schema.sql. ERD per group:
//         docs/database/diagrams/ (python docs/diagrams/ve_erd.py).
//
// Business model (docs/02, P&L API model). ELMS reads licenses, holders, and
// usage from one usage connector per company and provider, employees and units
// from ILVG, application usage from BCA, the budget plan from an Excel
// import, and the purchases (PO lines and invoices) from a SAP Excel import or
// a hand entry. Nobody enters a license in ELMS (BR-01).
//
// Decisions kept from the first design:
//   D1.  A "license" is a license plan (one tier or SKU, e.g. Microsoft 365 E3)
//        reported by one connector for one company. Holders, usage, budget
//        lines, PO lines, and invoices point to the plan; an entitlement line
//        is one PO line of that plan, from SAP or entered by hand (D50).
//   D2.  Employees (directory) and user accounts (login) are separate tables.
//   D5.  Two cost views: billed = expenses (invoices); effective = the monthly
//        cost split to units in cost_allocations. Since D33 the effective cost
//        of a month is the accrual of the expenses.
//   D7.  Per-seat status needs per-subject usage; an aggregate-only source
//        leaves seats Not monitored.
//   D8.  Completeness per connector and day: a day is complete when a run of
//        the connector for that day succeeded (sync_runs). The data lake
//        cleans the data before ELMS reads it; gaps inside one license are
//        not tracked.
//   D9.  History is kept by freezing results: daily snapshots, and
//        cost_allocations frozen when a month closes.
//   D10. Every plan has an owner unit (see D27).
//   D12. One reporting currency (VND); amounts converted with the rate of the
//        day, then frozen.
//   D13. Metered overuse = consumption over the validity of a line with a quota.
//   D14. Months close on a set day of the next month unless Staff close them
//        first (UC04); leavers' accounts are disabled automatically.
//   D20. Leavers: employees.left_on, from ILVG.
//   D22. A new account, created by the ILVG sync, gets a one-time link by email to set its first password.
//
// Decisions superseded by the business model:
//   D3, D19 (quotas per unit), D4 (one yearly budget per unit), D6 (service
//   month), D11 (one tenant per vendor), D15, D16 (recommendations and contract
//   notice periods), D17 (prices typed by Staff), D18 (manual holders and
//   usage), D21 (HR CSV import), D23 (reseller contracts). The tables they
//   used are removed (D38).
//
// Decisions of the business model revision (2026-11-15):
//   D24. Organization tree of five fixed levels, group > P&L > block >
//        department > project (BR-19): org_units.level and code; the group is
//        the only unit without parent; units come from ILVG.
//   D25. User scope: user_org_units (was manager_org_units) lists the units of
//        a Manager, at any level, the group included, and the companies of a
//        Staff member (a P&L, or the group for group-level Staff) (BR-14).
//   D26. One usage connector per company and provider (connectors.org_unit_id,
//        vendor_id). A license_plans row is one license a connector reports:
//        its external name and connector. Its license type (BR-02) is the
//        commercial_term of its PO line in force (entitlement_lines).
//   D27. Owner unit (BR-24): the P&L of the connector, or the group for a
//        shared license (used by two or more companies).
//   D28. Software catalog mapping (BR-35): license_plans.product_id NULL =
//        Not mapped; a product has one category; categories have one level.
//   D29. Budget versions (BR-08): each confirmed budget import is a version
//        (import_batches.version_no) for a target unit and months; its lines
//        belong to the deepest unit they name, per license and month; the
//        lines it replaces get superseded_by_import_id (which lines: D42). A
//        shared license is planned by the group, one line per P&L (BR-24).
//   D30. Idempotent budget import (BR-33): one preview_key per preview, the
//        latest version seen at preview (based_on_import_id, D43), and the
//        unchanged status when the file changes nothing.
//   D31. Seat status over 30 days with a 30-day grace for new seats (BR-03);
//        usage frequency = days used against working days, from active_days
//        usage records, without bands (BR-32).
//   D32. Cost split into used, wasted, and not evaluated (BR-22) on
//        cost_allocations; unassigned seats go to unallocated under the owner
//        unit, unplaced holders to unknown_unit (BR-06, BR-19).
//   D33. Purchased = accrued cost of the invoices (BR-09, UC04): an invoice
//        (expenses) pays a PO line and is spread over its term (D50); it keeps
//        its monthly spread (accrual_schedule), rounded to the thousand VND
//        (BR-23); months are closed per company.
//   D34. Connector sync interval and pause (BR-29): sync_interval_hours,
//        paused_at, reconfigured_at; a scheduled run while paused is a
//        sync_runs row with status paused.
//   D35. Account type of a provider identity: personal, shared, service
//        (BR-26); identities belong to the connector (tenant) that reports them.
//   D36. Employee application usage from BCA in its own table,
//        employee_app_usage (BR-21); the 40th table.
//   D37. BCA and ILVG are connectors too (connectors.kind), so their runs are
//        monitored like the usage connectors (UC10).
//   D38. Tables of retired use cases are removed: contracts,
//        entitlement_allocations, product_links, recommendations.
//   D39. A holder on several projects counts toward each in equal parts and
//        not toward their own unit (BR-06): employees.project_ids (one or
//        more projects), and seat
//        counts of plan_unit_daily_snapshots are shares (numeric).
//   D40. Deleting a connector (UC10) sets is_active false and keeps its data;
//        one active usage connector per company and provider.
//   D41. A shared or service account is judged as a whole account (BR-26):
//        its seat has a status like any other and its cost is Used or Wasted.
//
// Decisions of the schema review (2026-11-15):
//   D42. A budget import changes only the licenses in its file (BR-08): for
//        the target, every unit under it, and the months, each license of the
//        file replaces its own lines (a line of that license the file no
//        longer has is removed); licenses not in the file keep their lines. A
//        license of the file is its name (D51).
//   D43. Concurrent budget imports (BR-33): based_on_import_id is the
//        latest confirmed budget import of any unit at preview; the confirm is
//        refused when a line of its scope was written or superseded by an
//        import confirmed after it, so an import at the same unit, above, or
//        below is caught. Confirms run one at a time, so confirmed_at follows
//        commit order.
//   D44. The cost of a month is split by seat-days (BR-03, BR-06, BR-25):
//        each day carries cost / days in the month, split by the seats of that
//        day over max(purchased, assigned) seats, so an over-allocated license
//        spreads over its assigned seats and leaves nothing unallocated. A day
//        without complete seat data takes the seats of the nearest complete day
//        of the month (cost_allocations.filled_days). The cost of a day that
//        cannot be split — no complete day in the month, or Purchased quantity
//        Unknown — is Not evaluated under the owner.
//   D45. Superseded by D51: the budget file has no Shared column.
//   D46. Owner change (UC02): closed months keep the owner they were computed
//        with; open months follow the new owner. An expense keeps the company
//        that paid it. A P&L month that carries the cost of a shared license
//        stays Provisional until the group's month is closed too (BR-28).
//   D47. The fiscal year is the calendar year: accounting_periods has no
//        fiscal_year.
//   D48. When ILVG no longer reports a unit, the sync marks it inactive even if
//        employees, current budget lines, or licenses remain, and the unit is
//        listed to Admin (UC09). Admin alone still cannot deactivate it.
//   D49. Connector status is computed per license (BR-29) from the latest run
//        that brought data for it (license_plans.last_sync_run_id), so a
//        license added to a running connector is Pending.
//
// Decisions of 2026-11-16 (purchases from SAP):
//   D50. Purchases come from SAP (BR-10, UC04). entitlement_lines are the PO
//        lines: quantity, term, company (org_unit_id), PO number and item
//        (external_ref), and PR (pr_number), imported from the SAP purchase
//        file or entered by hand. expenses are the invoices, each paying a PO
//        line (entitlement_line_id) unless entered by hand without one.
//        Connectors no longer give quantities, terms, or billing.
//   D51. No Shared column in the budget file (supersedes D45). The license of
//        a budget line or PO line is found by its name in SAP
//        (license_plans.sap_name, else external_name) among the licenses of
//        the line's P&L and the shared licenses; a P&L's own license with the
//        name of a shared one gets another sap_name (BR-24).
//
// Conventions:
//   - Target DBMS: PostgreSQL 15+. Surrogate keys are bigint identity columns;
//     every table has a single-column id so audit_logs can point to any row.
//   - Money is numeric(18,2). Amounts from outside (prices, expenses, budget
//     lines) carry an ISO 4217 currency; figures ELMS computes (snapshots,
//     allocations, detection costs) are in the reporting currency and carry
//     none. Amounts in different currencies are only added through
//     exchange_rates (BR-05, D12).
//   - Quantities are numeric(20,4) because one column serves seats, sessions,
//     tokens, and cores.
//   - A NULL figure means Unknown and is never read as 0 (BR-04, A4). NULL has
//     no second meaning: a PO line without quota is told by its commercial
//     term (pay_as_you_go), not by a NULL quantity. A sum with
//     one Unknown part is Unknown, never the sum of the known parts (PostgreSQL
//     SUM skips NULL, so totals must check for NULL parts first).
//   - Master data is never deleted, only marked inactive or ended (BR-13), so
//     no foreign key cascades on delete.
//   - Where a date or timestamp decides a state, there is no status column
//     beside it: the group is the unit without parent_id, a month is closed
//     once closed_at is set, a connector is paused while paused_at is set, a
//     budget line is current while superseded_by_import_id is NULL, and a detection
//     result is not evaluated / clear / flagged when flagged_qty is NULL / 0 /
//     more than 0.
//   - Where a row has an end date, the date alone says whether it is active
//     (entitlement_lines.valid_to, employees.left_on,
//     license_assignments.ended_on, user_accounts.disabled_at). End dates are
//     inclusive: the row is valid on its last day.
//   - Each daily figure has one owner table: Purchased quantity in
//     plan_daily_snapshots, seat counts in plan_unit_daily_snapshots, period
//     usage in usage_records, completeness in sync_runs.
//     detection_results stores only the verdict.
//   - Confidence (BR-12, A9) is derived from the source, not stored:
//     api or log per holder = high; api or log aggregate, or import = medium;
//     manual = low.
//   - sync_run_id and import_batch_id on a row name the run or import that wrote
//     it last; source is the source of that write. Licenses, holders, and usage
//     come from connectors only: subjects, license_assignments, and
//     usage_records have no source column and a required sync_run_id. A
//     purchase (entitlement_lines, expenses, D50) comes from the SAP file when
//     import_batch_id is set, and was typed by Staff when created_by is set.
//   - Connector messages live at the level they describe:
//       whole run failed           sync_runs.error_message
//       one record                 raw_records.normalize_error
//     Messages are stored without secrets (tokens, keys).
//   - Settings are not stored in the database: they are application settings
//     of the API and the worker. reporting_currency VND (D12),
//     inactivity_threshold_days 30 and new_seat_grace_days 30 (BR-03, part of
//     the detection rule_version),
//     default_sync_interval_hours 6
//     (BR-29), month_close_day 10 (D14), raw_record_retention_days 180,
//     password_link_valid_hours 72 (D22), budget_preview_valid_minutes 60.
//   - updated_at is set by the application (or a trigger) on every update;
//     the default only covers the insert.
//   - Rules DBML cannot express are written in the table notes:
//       "Partial unique"  = a unique index with WHERE and/or NULLS NOT DISTINCT,
//                           to be created in the migration
//       "App rule"        = cross-table rule enforced in the service, inside the
//                           transaction that changes the data
// =============================================================================

Project elms {
  database_type: 'PostgreSQL'
  Note: '''
    Enterprise License Management System (ELMS).
    Read-only toward providers (BR-01): every table here holds data inside ELMS;
    nothing in this schema is written back to a provider.
  '''
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

Enum permission_action {
  read
  write
}

Enum data_source {
  api [note: 'Collected by a connector from a provider API, ILVG, or BCA']
  log [note: 'Collected by a connector from logs (license server, VPN)']
  import [note: 'File imported by a user: budget plan (UC04), SAP purchases (UC04)']
  manual [note: 'Typed in by Staff: purchases made outside SAP (UC04)']
}

Enum org_level {
  group [note: 'The whole group; the only unit without parent (BR-19)']
  pnl [note: 'P&L (company, subsidiary); parent is the group']
  block [note: 'Block (division); parent is a P&L']
  department [note: 'Department; parent is a block']
  project [note: 'Project; parent is a department']
}

Enum connector_kind {
  usage [note: 'Usage connector of one company and provider (UC10): licenses, holders, usage']
  ilvg [note: 'ILVG: employees and their units (system process)']
  bca [note: 'BCA: application usage of employees on company machines (BR-21)']
}

Enum connector_auth {
  api_key
  bearer_token
}


Enum holder_type {
  person [note: 'One employee of ILVG']
  shared [note: 'Group mailbox or shared account: judged as a whole account, Active or Inactive like any seat, cost Used or Wasted (BR-26, D41)']
  service [note: 'Service or system account: same as shared (BR-26, D41)']
  device [note: 'A machine that holds a device license']
  api_key [note: 'An API key or project of a usage-based license']
}
Enum vendor_kind {
  publisher [note: 'Makes the software; products belong to a publisher']
  reseller [note: 'Distributor, reseller, or CSP partner; owns no product. Not used by the agreed use cases (D23)']
}

Enum license_archetype {
  allocation [note: 'Seat, named user, device']
  concurrent [note: 'Slot, floating, VPN session']
  metered [note: 'Token, request, credit, GB']
  capacity [note: 'Core, CPU, server, instance']
}

Enum commercial_term {
  pay_as_you_go
  monthly
  yearly
  multi_year
  prepaid_credit
  perpetual [note: 'Perpetual with maintenance; only maintenance counts as cost (BR-05)']
}

Enum import_kind {
  budget [note: 'Budget plan from the ELMS Excel template (UC04, BR-08)']
  purchase [note: 'SAP purchase file: PO lines and invoices (UC04, D50)']
}
Enum usage_granularity {
  per_subject [note: 'Usage known per user, device, project, or key']
  aggregate [note: 'Only totals; seats stay Not monitored and are never listed per user (A9, D7)']
}

Enum usage_metric {
  active_subjects [note: 'Allocation, aggregate source only: number of active users in the period']
  active_days [note: 'Allocation, per subject: days with activity in the period, for days used (BR-32)']
  peak_concurrent [note: 'Concurrent: peak simultaneous sessions in the period']
  consumption [note: 'Metered: tokens, requests, credits, GB consumed in the period']
  deployed_units [note: 'Capacity: units deployed at the end of the period']
}
Enum sync_trigger {
  scheduled
  manual
  backfill [note: 'History loaded on the first connection (A5)']
}

Enum run_status {
  running
  success
  failed [note: 'Nothing written; figures of that day stay Unknown, never 0 (A4)']
  paused [note: 'Scheduled run of a paused connector: nothing read, the period stays Unknown (BR-29)']
}
Enum import_status {
  previewed [note: 'Parsed and validated; nothing written yet']
  confirmed [note: 'Rows written']
  rejected [note: 'At least one invalid row; whole file refused']
  unchanged [note: 'The file changes nothing (no row to add, change, or remove), for example the same file again: nothing written, no new version (BR-33)']
}
Enum cost_bucket {
  unit [note: 'Cost of the seats held by the people of a unit (BR-06)']
  unallocated [note: 'Cost of purchased seats nobody holds (Wasted) and cost that could not be split (Not evaluated), carried by the owner unit (P&L, or the group for a shared license)']
  unknown_unit [note: 'Cost of seats whose holder cannot be placed in a unit, carried by the owner unit (BR-19)']
}
Enum allocation_method {
  per_seat [note: 'Accrued cost split day by day over max(purchased, assigned) seats, by the seats of each day (seat-days, BR-06, D44)']
  per_usage [note: 'Metered license: split by the consumption of subjects with a known unit']
  direct [note: 'Expense that names a unit goes to that unit']
  none [note: 'No seat data in the whole month: the cost stays with the owner (unallocated) as Not evaluated (BR-04, D44)']
}
Enum detection_check {
  unused [note: 'Unassigned seats (UC05)']
  inactive [note: 'Seats in Inactive or No activity (UC05)']
  overuse [note: 'Allocated above purchased (BR-07, BR-31)']
  leaver [note: 'Open seats of employees who left (D20)']
}
// ----------------------------------------------------------------------------
// 1. Organization and access (UC08, UC09, UC12, BR-14, BR-19)
// ----------------------------------------------------------------------------

Table org_units {
  id bigint [pk, increment]
  parent_id bigint [ref: > org_units.id, note: 'NULL only for the group; otherwise the unit one level up']
  level org_level [not null, note: 'group, pnl, block, department, or project (BR-19)']
  code varchar(50) [not null, unique, note: 'Unit code from ILVG; the key the budget file, the SAP purchase file, and connectors use (BR-08, BR-10)']
  name varchar(200) [not null]
  is_active boolean [not null, default: true]
  sync_run_id bigint [ref: > sync_runs.id, note: 'ILVG run that wrote the unit last; NULL for the seeded group row']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (parent_id, name) [unique, name: 'uq_org_units_parent_name']
    level
  }

  checks {
    `parent_id is null or parent_id <> id` [name: 'chk_org_units_not_own_parent']
    `(level = 'group') = (parent_id is null)` [name: 'chk_org_units_group_root']
  }

  Note: '''
    The organization in five fixed levels: group > P&L > block > department >
    project (BR-19, D24). A "unit" in the docs is one row of this table. Units
    come from ILVG (system process); Admin assigns Managers (UC09) and can
    correct a unit ILVG placed wrongly, with a reason, through data_overrides.
    Partial unique: one group row (unique on level where level = 'group').
    App rule: the parent of a unit is one level up (pnl -> group, block -> pnl,
    department -> block, project -> department), which also rules out cycles;
    Admin cannot mark inactive a unit with active employees, a current budget
    line, or licenses it owns; when ILVG no longer reports such a unit, the
    sync marks it inactive anyway and the unit is listed to Admin (computed:
    inactive units that still have any of these), who moves what is left
    (D48, UC09). Every figure of a unit is the sum of the units
    under it (BR-19); Unallocated and Unknown unit are buckets of
    cost_allocations under the owner unit, not rows here.
  '''
}
Table employees {
  id bigint [pk, increment]
  employee_code varchar(50) [unique, note: 'ILVG employee id; the key that joins ILVG, BCA, and holder identities (BR-25)']
  full_name varchar(200) [not null]
  email varchar(320) [not null, unique, note: 'Current company email, stored lowercase; login email of the account']
  org_unit_id bigint [ref: > org_units.id, note: 'Unit of the position, from ILVG: the department, or the block or P&L when the position is not in a department. Never a project: projects are in project_ids. NULL = Unknown unit (BR-19)']
  project_ids bigint[] [note: 'Projects the employee works on, from ILVG, one or more; a seat counts toward each in equal parts and not toward org_unit_id (BR-06, D39). NULL = no project: the seat counts toward org_unit_id']
  left_on date [note: 'Last working day, from ILVG; NULL = still with the company (D20). After it the account is disabled and seats still held are flagged by the leaver check']
  source data_source [not null, default: 'api', note: 'Always api: employees come only from the ILVG sync (BR-15)']
  sync_run_id bigint [ref: > sync_runs.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    org_unit_id
    left_on
  }

  checks {
    `email = lower(email)` [name: 'chk_employees_email_lowercase']
    `source = 'api'` [name: 'chk_employees_ilvg_only']
    `sync_run_id is not null` [name: 'chk_employees_sync_provenance']
  }

  Note: '''
    Directory of real employees (decision D2), loaded from ILVG. An employee
    may have no account, so provider identities of people without an ELMS
    account still match an employee and a unit.
    Cost allocation, data scope, and "Unknown unit" read org_unit_id here,
    never from the account. Only the current unit is kept (D9); past months
    keep their unit through the frozen snapshots and cost_allocations. ILVG
    gives no transfer date: cost follows the unit of each day's snapshot (D44),
    so a transfer counts from the day ELMS receives it, and the days before
    stay with the old unit (BR-25). An employee on projects has them in
    project_ids: a seat they hold counts toward each project in equal parts,
    the whole seat for one, half a seat each for two, and nothing toward
    org_unit_id (BR-06, D39).
    The other emails of a person over time are the person subjects matched to
    this employee (subjects.employee_id), so one person holds licenses under
    several emails (UC01, UC11).
    App rule: every element of project_ids is an org_units row of level project.
    App rule: once left_on has passed, the account of the employee is disabled
    (same transaction when the day is already past, otherwise the daily job)
    (D14).
  '''
}
Table roles {
  id bigint [pk, increment]
  code varchar(30) [not null, unique, note: 'ADMIN, MANAGER, STAFF, EMPLOYEE']
  name varchar(100) [not null]
  description text

  Note: 'The four fixed roles (BR-15). Seeded; UC08 changes the role of a user, not this list.'
}

Table permissions {
  id bigint [pk, increment]
  feature_code varchar(60) [not null, note: 'Code of the feature, one per row of the role x feature matrix, e.g. 123FV@; not the feature name. The name shown is in description']
  action permission_action [not null]
  description text

  indexes {
    (feature_code, action) [unique, name: 'uq_permissions_feature_action']
  }

  Note: 'Catalogue of what can be granted: feature x (read | write) (UC08). Seeded.'
}

Table role_permissions {
  id bigint [pk, increment]
  role_id bigint [not null, ref: > roles.id]
  permission_id bigint [not null, ref: > permissions.id]

  indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions_role_permission']
  }

  Note: '''
    Permission matrix; permissions belong to roles, never to single users (BR-15).
    App rule: Employee cannot be granted price or cost features; the permission
    Admin needs to manage permissions cannot be removed (UC08). Every change is
    written to audit_logs with its reason.
  '''
}

Table user_accounts {
  id bigint [pk, increment]
  employee_id bigint [not null, unique, ref: - employees.id, note: 'Every account belongs to one employee; login email = employees.email']
  role_id bigint [not null, ref: > roles.id, note: 'Exactly one role per account (BR-15)']
  password_hash varchar(255) [note: 'Hashed, never plain (BR-16). NULL until the user sets a first password through the one-time link; login is refused']
  password_token_hash char(64) [unique, note: 'SHA-256 of the one-time link that sets or resets the password (D22); NULL = no link open']
  password_token_expires_at timestamptz [note: 'End of validity of that link: created + password_link_valid_hours']
  failed_login_count int [not null, default: 0, note: 'Consecutive failures; reset on success']
  locked_until timestamptz [note: 'Set to now + 15 minutes after 5 failures in a row (BR-16)']
  last_login_at timestamptz
  disabled_at timestamptz [note: 'NULL = active. Set = disabled: cannot log in and open sessions are revoked (UC08); cleared on re-enable']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    role_id
  }

  checks {
    `failed_login_count >= 0` [name: 'chk_user_accounts_failed_count']
    `(password_token_hash is null) = (password_token_expires_at is null)` [name: 'chk_user_accounts_password_token']
  }

  Note: '''
    Login accounts (UC08, UC12). Accounts are disabled, never deleted.
    First password and reset (D22): the ILVG sync creates the account of a new
    employee with the role Employee (BR-15), and "Forgot password" on the login
    screen asks for a new link; each stores the hash of a new random token and
    emails the link to the login email. Opening the link before it expires sets password_hash, clears the token, and resets
    failed_login_count and locked_until. A new link replaces the old one.
    App rule: the last active Admin cannot be disabled or lose the Admin role;
    an Admin cannot disable themselves (BR-15). An account of an employee whose
    left_on has passed cannot be re-enabled (D14). A role change away from
    MANAGER or STAFF removes the rows of the account in user_org_units.
    Disabling an account clears its open password link.
  '''
}

Table user_sessions {
  id bigint [pk, increment]
  user_account_id bigint [not null, ref: > user_accounts.id]
  token_hash char(64) [not null, unique, note: 'SHA-256 of the session id kept in the HttpOnly, Secure cookie']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  indexes {
    user_account_id
    expires_at
  }

  checks {
    `expires_at > created_at` [name: 'chk_user_sessions_expiry']
  }

  Note: '''
    Server-side sessions, so disabling an account ends its open sessions at once
    (UC08, BR-16). A new session id is issued at login (no session fixation).
    Logout, disabling the account, and a role change delete the rows of the
    session; expired rows are purged by a daily job. Cookie sessions need
    CSRF protection (SameSite cookie plus a CSRF token on writes).
  '''
}

Table user_org_units {
  id bigint [pk, increment]
  user_account_id bigint [not null, ref: > user_accounts.id]
  org_unit_id bigint [not null, ref: > org_units.id]

  indexes {
    (user_account_id, org_unit_id) [unique, name: 'uq_user_org_units_account_unit']
    org_unit_id
  }

  Note: '''
    Data scope of a Manager or a Staff member (BR-14, D25); was
    manager_org_units.
      MANAGER  the units they are responsible for, at any level, the group
               included (UC09); a unit covers everything under it
      STAFF    the companies they work on (UC08): a P&L, or the group for
               group-level Staff, who see every company and keep the software
               catalog and the shared licenses (UC02)
    Admin and Employee have no rows: Admin reads no license data; an Employee reads only their own licenses.
    Who assigned a row and when is in audit_logs.
    App rule: the account has the MANAGER or STAFF role; for STAFF the unit is
    a P&L or the group.
  '''
}
// ----------------------------------------------------------------------------
// 2. Software catalog and licenses (UC01, UC02)
// ----------------------------------------------------------------------------

Table vendors {
  id bigint [pk, increment]
  code varchar(50) [not null, unique, note: 'Short code of the provider, e.g. MSFT, ATLASSIAN']
  name varchar(200) [not null, unique]
  kind vendor_kind [not null, default: 'publisher', note: 'publisher or reseller (D23)']
  website varchar(500)
  support_contact varchar(500)
  is_active boolean [not null, default: true]
  created_by bigint [ref: > user_accounts.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Providers (UC02): Microsoft, Atlassian, Adobe... A usage connector reads
    one provider for one company (D26). It covers every way of paying, seats
    or pay-as-you-go: how a license is paid is on its PO lines
    (entitlement_lines.commercial_term). Resellers (kind reseller, D23) are
    not used by the agreed use cases.
    The migration makes the code unique case-insensitive (on lower(code)).
    UC02 lists the providers that have licenses in the period; quantities are
    shown per license only, never added across licenses (BR-05).
    App rule: a provider with an active connector cannot be marked inactive;
    products and connectors belong to a publisher only.
  '''
}


Table software_categories {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]

  Note: '''
    Categories of the software catalog, one level, kept by group-level Staff
    (UC02, BR-35), e.g. Productivity, Design, Development.
    The migration makes the name unique case-insensitive (on lower(name)).
    App rule: a category used by a product cannot be deleted.
  '''
}

Table software_products {
  id bigint [pk, increment]
  vendor_id bigint [not null, ref: > vendors.id]
  category_id bigint [ref: > software_categories.id, note: 'Its category. NULL is shown as Uncategorized']
  name varchar(200) [not null]
  description text
  is_active boolean [not null, default: true]
  created_by bigint [ref: > user_accounts.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (vendor_id, name) [unique, name: 'uq_software_products_vendor_name']
    category_id
  }

  Note: '''
    Software of the catalog (UC02, BR-35), e.g. Microsoft 365: the level the
    license names of every company map to, so the License Dashboard (UC07)
    and the analysis by software and category (UC07) count M365 E3 of company
    A and Microsoft 365 E3 of company B together.
    Figures per software (seats Active, Inactive, No activity, Not monitored,
    per unit and day) are not stored here: they are the sum of
    plan_unit_daily_snapshots over its licenses (license_plans.product_id).
    The migration makes the name unique case-insensitive (on lower(name)).
    App rule: a product with mapped licenses cannot be deleted, only merged
    into another product (its licenses are mapped to the other one, audited).
  '''
}

Table license_plans {
  id bigint [pk, increment]
  connector_id bigint [not null, ref: > connectors.id, note: 'Usage connector that reports the license for its company (D26)']
  external_name varchar(200) [not null, note: 'License name as the source gives it, or as Staff typed it on the connector until the first sync (UC10)']
  external_ref varchar(200) [note: 'Id of the license at the source, e.g. Microsoft Graph skuId; NULL until the first sync']
  sap_name varchar(200) [note: 'Name SAP files use for the license when it differs from external_name (UC02, D51); NULL = external_name']
  product_id bigint [ref: > software_products.id, note: 'Software of the catalog (UC02, BR-35). NULL = Not mapped, grouped under Uncategorized']
  archetype license_archetype [not null, default: 'allocation', note: 'How it is counted: seats (allocation), sessions, consumption, or capacity']
  unit varchar(30) [not null, default: 'seat', note: 'What is counted: seat, device, slot, token, credit, GB, core ...']
  owner_org_unit_id bigint [not null, ref: > org_units.id, note: 'Owner unit (D27): the P&L of the connector, or the group for a shared license (BR-24)']
  last_sync_run_id bigint [ref: > sync_runs.id, note: 'Latest successful run that brought data for the license; gives its connector status (BR-29, D49). NULL = no data yet (Pending)']
  usage_granularity usage_granularity [note: 'How the connector gives usage: per_subject (per holder) or aggregate (totals only). NULL = no usage source: seats are Not monitored, never waste (BR-03, BR-04, D7)']
  has_daily_activity boolean [note: 'Per-holder usage only: true when the source gives activity per day (active_days), so days used are counted; false when it gives only the last activity date, so frequency is Not tracked (BR-32)']
  monitoring_since date [note: 'First day the connector delivered usage for the license; a seat is called Inactive only after 30 days of monitoring (BR-03). NULL = no usage yet']
  is_active boolean [not null, default: true, note: 'False once the connector no longer reports it, Staff removed it from the connector, or the connector was deleted (UC10)']
  created_by bigint [ref: > user_accounts.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    product_id
    owner_org_unit_id
    archetype
  }

  checks {
    `has_daily_activity is null or usage_granularity = 'per_subject'` [name: 'chk_license_plans_daily_activity']
    `usage_granularity is null or monitoring_since is not null` [name: 'chk_license_plans_monitoring_since']
  }

  Note: '''
    The unit everything else calls "a license" (D1): one license a connector
    reports for its company, such as "Microsoft 365 E3" of company A. Staff
    declare it on the connector (UC10); it is Pending until the first sync
    (BR-29) and then carries the external_ref of the source.
    License type (BR-02) is not stored: it is the commercial_term of the PO
    line in force on the day (entitlement_lines); Unknown without one.
    Holders, usage, budget lines, PO lines (entitlement_lines), and invoices
    (expenses) point to it; it stays the same across renewals. Purchased
    quantity = sum of its PO lines active on a day.
    Name in SAP (D51): budget lines and PO lines find the license by
    lower(coalesce(sap_name, external_name)) among the licenses of their P&L
    and the shared licenses. Staff set sap_name when SAP uses another name
    (UC02), for example a P&L's own license that has the name of a shared one.
    Software and category (BR-35): product_id maps it to the catalog (UC02).
    Mapping one name maps every license of the same provider with the same
    name (lower(external_name)), in every company; a new name is Not mapped.
    Owner unit (D27, BR-24): the P&L of the connector's company; Staff set it to
    the group when the license is used by two or more companies (UC02). The
    owner carries the unassigned seats (cost_allocations unallocated) and plans
    the license; the cost of held seats is charged back to the holders' units.
    "Possibly shared" is computed: open seats held by employees of two or more
    P&Ls.
    Partial unique: one row per connector and name, case-insensitive (unique
    on connector_id, lower(external_name)), and one per connector and
    external_ref where external_ref is not null.
    Figures per license (seats per status, per unit and day) are in
    plan_unit_daily_snapshots; how often each holder uses it is in
    usage_records (active_days).
    App rule: owner_org_unit_id is the P&L of the connector or the group; the vendor of
    product_id is the vendor of the connector; changing product_id, sap_name,
    or owner_org_unit_id is written to audit_logs (BR-13). Changing
    owner_org_unit_id recomputes the open months under the new owner; closed
    months keep the owner they were computed with (D46).
  '''
}
Table entitlement_lines {
  id bigint [pk, increment]
  license_plan_id bigint [not null, ref: > license_plans.id, note: 'License the PO line names, found by its name in SAP (D51)']
  org_unit_id bigint [not null, ref: > org_units.id, note: 'Company that issued the PO, or bought outside SAP: a P&L or the group (BR-10); it does not follow a later owner change (D46)']
  quantity numeric(20,4) [note: 'Quantity of the PO line. NULL = Unknown; always NULL for pay_as_you_go, which has no quota']
  valid_from date [not null, note: 'Start of the term on the PO line (BR-10): from this day the line counts in Purchased']
  valid_to date [note: 'End of the term on the PO line, inclusive: the expiry (BR-30). NULL = open-ended']
  commercial_term commercial_term [not null, note: 'How the term is paid, from the length of the term (a month = monthly, a year = yearly, longer = multi_year); it also fixes the period of unit_price. pay_as_you_go = no quota: the line can never be over-allocated (BR-07)']
  unit_price numeric(18,4) [note: 'Net price of price_per_qty units on the PO line for the period of the commercial term. NULL = Unknown']
  price_per_qty numeric(20,4) [not null, default: 1, note: 'How many units unit_price is quoted for: 1 for a seat, 1000000 for "2.50 USD per 1M tokens"']
  currency char(3) [not null]
  external_ref varchar(200) [note: 'PO number and item in SAP, e.g. 4500012345/10: the key a re-import updates (BR-33). NULL for a hand entry']
  pr_number varchar(50) [note: 'Purchase requisition the PO came from, as SAP gives it; shown in UC04, not used in figures']
  import_batch_id bigint [ref: > import_batches.id, note: 'SAP import that last wrote the line; NULL for a hand entry']
  created_by bigint [ref: > user_accounts.id, note: 'Staff who entered a hand line; NULL for an imported line']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (license_plan_id, valid_from, valid_to)
    valid_to
    org_unit_id
  }

  checks {
    `quantity is null or quantity >= 0` [name: 'chk_entitlement_lines_quantity']
    `commercial_term <> 'pay_as_you_go' or quantity is null` [name: 'chk_entitlement_lines_payg_no_quota']
    `valid_to is null or valid_to >= valid_from` [name: 'chk_entitlement_lines_validity']
    `unit_price is null or unit_price >= 0` [name: 'chk_entitlement_lines_unit_price']
    `price_per_qty > 0` [name: 'chk_entitlement_lines_price_per_qty']
    `(import_batch_id is null) = (created_by is not null)` [name: 'chk_entitlement_lines_provenance']
    `(import_batch_id is not null) = (external_ref is not null)` [name: 'chk_entitlement_lines_po_ref']
    `import_batch_id is not null or pr_number is null` [name: 'chk_entitlement_lines_manual_no_pr']
  }

  Note: '''
    One PO line of a license (BR-10, D50): quantity, term, and price, from the
    SAP purchase file (UC04) or entered by hand by Staff for a purchase made
    outside SAP. It gives Purchased quantity (UC01, BR-31), the license terms
    (UC01), and the expiry (BR-30, UC01). A renewal or an extra purchase is a
    new PO line under the same license. Connectors do not report quantities or
    terms.
    A line is active on a day when valid_from <= day and (valid_to is null or
    valid_to >= day). A renewal starts the day after the previous line ends,
    so the boundary day is never counted twice. The term gives Purchased on a
    day (the lines active that day), the expiry in the License List, the
    commercial term, and the default period an invoice is spread over
    (expenses.service_from, service_to).
    unit_price is shown with the line; Purchased in money is the accrued cost
    of the invoices (expenses, D33), not this price.
    A change to a line, by a re-import or a hand edit, changes only the days
    not frozen yet (plan_daily_snapshots, D9).
    Partial unique: one line per PO line of a company (unique on org_unit_id,
    external_ref where external_ref is not null), so a re-import updates the
    line instead of adding one (BR-33).
    App rule: org_unit_id is one of the companies of the Staff member who
    imports or enters the line (BR-14); license_plan_id is a license of that
    company or a shared license, matched by name (D51).
  '''
}

// ----------------------------------------------------------------------------
// 3. Collection pipeline (UC04, UC10 imports)
// ----------------------------------------------------------------------------

Table connectors {
  id bigint [pk, increment]
  kind connector_kind [not null, default: 'usage', note: 'usage connector of a company and provider, or the ILVG or BCA source (D37)']
  org_unit_id bigint [ref: > org_units.id, note: 'Company of a usage connector: a P&L, or the group for a group contract. NULL for ILVG and BCA']
  vendor_id bigint [ref: > vendors.id, note: 'Provider a usage connector reads. NULL for ILVG and BCA']
  name varchar(200) [not null, unique, note: 'Generated: "<Company> - <Provider> Usage" (UC10)']
  connector_type varchar(60) [not null, note: 'Implementation key, e.g. generic_rest, ms_graph, ilvg, bca']
  api_url varchar(500) [not null, note: 'Full HTTPS address of the endpoint the P&L provides for its own data (UC10), e.g. https://api.company.com/v1/usage']
  auth_type connector_auth [not null, note: 'API key or bearer token (UC10)']
  credentials_ref text [not null, note: 'Where the API key or token is kept: a reference to the secret store, never the secret itself. The worker reads the secret through it at each run; write-only, never shown, exported, or logged (BR-18)']
  contact_name varchar(100) [note: 'Person at the company who answers for its API, called when runs fail; required for a usage connector (UC10)']
  contact_email varchar(160) [note: 'Email of that person, also searchable in UC10; required for a usage connector']
  sync_interval_hours int [not null, default: 6, note: 'How often the connector runs, typed freely by Staff, at least 1 (BR-29, UC10)']
  reconfigured_at timestamptz [not null, default: `now()`, note: 'Last change of company, provider, authentication, or API URL: every license is Pending again and runs before it no longer count (BR-29)']
  paused_at timestamptz [note: 'NULL = running; set = paused by Staff (UC10): scheduled runs are written with status paused']
  paused_by bigint [ref: > user_accounts.id]
  is_active boolean [not null, default: true, note: 'False once deleted by Staff (UC10): no more runs; its licenses become inactive and the data collected stays (BR-13)']
  created_by bigint [ref: > user_accounts.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    org_unit_id
    vendor_id
  }

  checks {
    `(kind = 'usage') = (org_unit_id is not null and vendor_id is not null)` [name: 'chk_connectors_usage_target']
    `kind <> 'usage' or (contact_name is not null and contact_email is not null)` [name: 'chk_connectors_usage_contact']
    `sync_interval_hours > 0` [name: 'chk_connectors_interval']
    `(paused_at is null) = (paused_by is null)` [name: 'chk_connectors_paused']
    `api_url like 'https://%'` [name: 'chk_connectors_https']
  }

  Note: '''
    One read-only connection (D26, D37). A usage connector reads one provider
    for one company and answers in the license data contract (BR-17); its
    licenses are the license_plans rows with its connector_id. ILVG and BCA are
    connectors of their own kind, so every source is monitored the same way
    (UC10).
    Status of each license of a connector (BR-29, D49), computed, not stored,
    from the runs of the connector and license_plans.last_sync_run_id:
      Paused   paused_at is set
      Pending  last_sync_run_id is NULL or started before reconfigured_at
               (also a license added to a running connector)
      Failed   the latest finished run failed
      Delayed  last_sync_run_id finished longer ago than sync_interval_hours
               (also a license the latest runs brought no data for)
      Active   otherwise
    Paused slots are left out of "latest run". Sync issues = Delayed + Failed.
    Partial unique: one active usage connector per company and provider
    (unique on org_unit_id, vendor_id where kind = 'usage' and is_active), so a
    deleted connector can be created again; one ILVG and one BCA connector
    (unique on kind where kind <> 'usage').
    App rule: a connection is saved only after its test passes (BR-18);
    editing company, provider, authentication, or API URL sets reconfigured_at
    and requires a new credential when provider or authentication changes
    (UC10); the interval and the licenses can change without it. Pause and
    resume are written to audit_logs (BR-13). Delete (UC10, D40) sets
    is_active false on the connector and its licenses in one transaction,
    after a confirmation; nothing is removed.
  '''
}
Table sync_runs {
  id bigint [pk, increment]
  connector_id bigint [not null, ref: > connectors.id]
  trigger sync_trigger [not null, default: 'scheduled', note: 'scheduled, manual (run now or rerun a period, UC10), or backfill']
  status run_status [not null, default: 'running']
  data_date date [not null, note: 'The day the collected figures describe (reports lag 1-2 days); the period a rerun replaces']
  window_start timestamptz [note: 'Incremental window (A3)']
  window_end timestamptz
  error_message text [note: 'Only when the run failed (bad credentials, source unreachable)']
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  indexes {
    (connector_id, data_date)
    status
  }

  checks {
    `(status = 'running') = (finished_at is null)` [name: 'chk_sync_runs_finished']
    `finished_at is null or finished_at >= started_at` [name: 'chk_sync_runs_duration']
    `window_end is null or window_start is null or window_end >= window_start` [name: 'chk_sync_runs_window']
    `(status = 'failed') = (error_message is not null)` [name: 'chk_sync_runs_error']
    `status <> 'paused' or finished_at = started_at` [name: 'chk_sync_runs_paused']
  }

  Note: '''
    One execution of a connector, or one scheduled slot of a paused connector
    (status paused, nothing read, BR-29), so the run table of UC10 shows the
    pause like any run. A failed or paused run writes no figures, so that day
    stays Unknown instead of 0 (A4, BR-04); the next run catches up (A3). A
    rerun of the same connector and data date replaces the figures and never
    duplicates them (BR-33).
    A day of a connector is complete when a run for that data_date succeeded;
    otherwise it is Unknown: detection reports not_evaluated (UC05, UC06) and
    daily snapshots are not written for it (D8). The data lake cleans the data
    before ELMS reads it, so ELMS does not track gaps inside one license.
    A backfill writes one run per data date.
    What a run returned is found through sync_run_id: its records in
    raw_records and the rows it wrote last in the other tables. Record counts
    are not stored: they are counted from those tables while the records are
    kept.
  '''
}

Table raw_records {
  id bigint [pk, increment]
  sync_run_id bigint [not null, ref: > sync_runs.id]
  record_type varchar(60) [not null, note: 'Kind of record in the license data contract, e.g. license, holder, usage']
  external_id varchar(200) [note: 'Id of the record at the source, e.g. the license id or the holder account']
  payload jsonb [not null, note: 'The cleaned record as the data lake delivered it']
  fetched_at timestamptz [not null, default: `now()`, note: 'When ELMS read it from the data lake']
  normalized_at timestamptz [note: 'NULL until processed; set also when the record failed or was skipped']
  normalize_error varchar(200) [note: 'NULL = written to the tables below. Otherwise why not, e.g. undeclared_license, unknown_employee, invalid_date, missing_field (BR-17)']

  indexes {
    (sync_run_id, record_type)
    (record_type, external_id)
  }

  checks {
    `normalize_error is null or normalized_at is not null` [name: 'chk_raw_records_normalize_error']
  }

  Note: '''
    Records as ELMS reads them, before they are written to the tables below.
    Connectors push what they collect to a data lake, which cleans it; this
    table holds the cleaned records, not the raw data of the provider. They
    are kept so figures can be recomputed when a rule changes without reading
    the data lake again (A2). A failed run is reported in sync_runs.
    A record ELMS cannot use keeps its reason in normalize_error; the
    rejected records of a run, with the check that failed, are what Staff see
    in UC10. A license the source reports but the connector does not declare
    is undeclared_license, listed for Staff to add to the connector (UC10), so
    no purchase is silently left out. A person whose employee code and email
    are not in ILVG does not exist for ELMS: the record is unknown_employee.
    A written row points to the run that wrote it (sync_run_id), not to its
    record here: records are deleted after the retention period. The record
    of a row is found by sync_run_id and external_id.
    Payloads hold personal data (names, emails): only the collection service
    reads this table, and rows older than raw_record_retention_days
    (application setting) are deleted. Idempotency is ensured by the unique
    keys of the normalized tables.
  '''
}

Table files {
  id bigint [pk, increment]
  storage_key varchar(500) [not null, unique, note: 'Path or object key in file storage; the bytes are not in the database']
  original_name varchar(255) [not null]
  content_type varchar(100) [not null]
  size_bytes bigint [not null]
  checksum char(64) [not null, note: 'SHA-256 of the content; tells the same file uploaded again in the import history']
  uploaded_by bigint [ref: > user_accounts.id]
  uploaded_at timestamptz [not null, default: `now()`]

  checks {
    `size_bytes > 0 and size_bytes <= 10485760` [name: 'chk_files_size']
  }

  Note: '''
    Uploaded files: invoice files of hand entries (PDF or image, at most
    10 MB, BR-10), budget plan Excel files (UC04), and SAP purchase Excel
    files (UC04). A budget file that
    changes nothing is told by its preview, not by checksum (BR-33). The service
    checks the content type from the bytes, not from the name; files are
    served only through the API with the permission of the row they belong to.
  '''
}

Table import_batches {
  id bigint [pk, increment]
  import_type import_kind [not null]
  file_id bigint [not null, ref: > files.id]
  target_org_unit_id bigint [ref: > org_units.id, note: 'Budget: the unit where, with every unit under it, the file changes the licenses it names (BR-08, D42)']
  period_from date [note: 'Budget: first day of the first month the file covers']
  period_to date [note: 'Budget: first day of the last month the file covers']
  preview_key uuid [not null, unique, note: 'Idempotency key of the confirm: a second confirm of the same key returns the first result (BR-33)']
  based_on_import_id bigint [ref: > import_batches.id, note: 'Budget: the latest confirmed budget import of any unit when the preview was made (NULL = none yet); confirm is refused if an import confirmed after it wrote or superseded a line of the import scope (BR-33, D43)']
  version_no int [note: 'Budget: version of the plan of the target unit this import created on confirm, 1, 2, 3 ... per target unit; NULL until confirmed and for purchase imports (D29)']
  note text [note: 'Budget: free notes of the Manager on the version']
  status import_status [not null, default: 'previewed']
  rows_total int [not null, default: 0]
  rows_added int [not null, default: 0]
  rows_updated int [not null, default: 0, note: 'Rows whose line in force has another quantity, amount, or currency']
  rows_removed int [not null, default: 0, note: 'Budget: lines in force of the file licenses, in the target and under it, that the file no longer has (UC04, D42)']
  rows_rejected int [not null, default: 0]
  error_report jsonb [note: 'Rejected rows with their reasons']
  imported_by bigint [not null, ref: > user_accounts.id]
  created_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz

  indexes {
    (import_type, created_at)
    (target_org_unit_id, period_from)
    (target_org_unit_id, version_no) [unique, name: 'uq_import_batches_unit_version']
  }

  checks {
    `(status = 'confirmed') = (confirmed_at is not null)` [name: 'chk_import_batches_confirmed']
    `(import_type = 'budget') = (target_org_unit_id is not null and period_from is not null and period_to is not null)` [name: 'chk_import_batches_budget_target']
    `period_to is null or period_to >= period_from` [name: 'chk_import_batches_period']
    `(version_no is not null) = (import_type = 'budget' and status = 'confirmed')` [name: 'chk_import_batches_budget_version']
    `version_no is null or version_no > 0` [name: 'chk_import_batches_version_positive']
    `import_type = 'budget' or (based_on_import_id is null and note is null)` [name: 'chk_import_batches_budget_only']
    `period_from is null or (extract(day from period_from) = 1 and extract(day from period_to) = 1 and extract(year from period_from) = extract(year from period_to))` [name: 'chk_import_batches_months_of_one_year']
    `rows_total >= 0 and rows_added >= 0 and rows_updated >= 0 and rows_removed >= 0 and rows_rejected >= 0` [name: 'chk_import_batches_counts']
  }

  Note: '''
    One import: preview, then confirm (UC04 budget, UC04 purchases). This is
    the import history "who, when, file, target, months, rows".
    Budget import (BR-08, BR-33, D29, D30, D42, D43):
    - scope of the import = the target and every unit under it, x the months,
      x the licenses of the file (by name, D51). Licenses not
      in the file and units outside the target are never touched.
    - preview: parse the file, check every row (unit codes in the hierarchy
      and inside the target subtree, one row per unit, license, and month), compare with the lines in force of the scope, and count rows to
      add (no line in force), replace (another quantity, amount, or
      currency), remove (a line in force of the scope the file no longer
      has), and reject; store based_on = the latest confirmed budget import
      of any unit (NULL when there is none).
    - nothing to add, replace, or remove -> status unchanged, "No changes",
      no version (the same file again ends here).
    - confirm: in one transaction, take the budget import lock (confirms run
      one at a time, so confirmed_at follows commit order); refuse when a
      line of the scope has import_batch_id or superseded_by_import_id of an
      import confirmed after based_on, or any value when based_on is NULL
      ("The plan changed since your preview"), so an import at the same unit,
      above, or below that touched the same licenses and months is caught;
      set version_no to the next version of the target unit; supersede the
      lines it replaces or removes; insert the added and replaced lines.
      Lines that do not change stay as they are.
      A confirmed budget import is a version of the plan (D29): it is never
      edited or deleted, and earlier versions are kept for "compare with the
      previous version" (UC04).
      A second confirm with the same preview_key returns this result again.
    - a preview older than budget_preview_valid_minutes must be made again.
    Purchase import (UC04, BR-10, BR-33, D50):
    - preview: parse the PO lines and invoices; each row's company is one of
      the importer's companies; each PO line finds its license by name (D51);
      each invoice finds its PO line, in the file or imported before; count
      rows to add (new PO number and item, or new invoice), update (another
      quantity, term, price, or amount), and reject.
    - confirm: in one transaction, upsert entitlement_lines and expenses by
      (org_unit_id, external_ref); a change that falls in a closed month is
      not written there, its difference goes to the next open month (UC04).
      A second confirm with the same preview_key returns this result again.
    App rule: the target is one of the importer's units or under one
    (user_org_units, BR-14).
  '''
}
// ----------------------------------------------------------------------------
// 4. Holders, usage, and history (UC01, UC03, UC05, UC11, Usage screen)
// ----------------------------------------------------------------------------

Table subjects {
  id bigint [pk, increment]
  connector_id bigint [not null, ref: > connectors.id, note: 'Connector (company tenant) the account lives at; the same email in two tenants is two accounts (D35)']
  holder_type holder_type [not null, default: 'person', note: 'person, shared, service, device, or api_key (BR-26)']
  identifier varchar(320) [not null, note: 'How the provider names the account, lowercase: email, mailbox, device name, key label']
  employee_id bigint [ref: > employees.id, note: 'The ILVG employee, by employee code, otherwise by email (BR-25). Set only for a person']
  org_unit_id bigint [ref: > org_units.id, note: 'Unit that owns an account that is not a person: shared mailbox, service account, device, key (BR-26). NULL = Unknown unit']
  sync_run_id bigint [not null, ref: > sync_runs.id, note: 'Connector run that last wrote the account']

  indexes {
    (connector_id, identifier) [unique, name: 'uq_subjects_connector_identifier']
    employee_id
    org_unit_id
  }

  checks {
    `(holder_type = 'person') = (employee_id is not null)` [name: 'chk_subjects_person_employee']
    `holder_type <> 'person' or org_unit_id is null` [name: 'chk_subjects_person_no_unit']
    `identifier = lower(identifier)` [name: 'chk_subjects_identifier_lowercase']
  }

  Note: '''
    The accounts that hold licenses at a provider: people, shared mailboxes,
    service accounts, devices, and API keys. A person is always an ILVG
    employee: a person the source reports whose employee code and email are
    not in ILVG is rejected (raw_records.normalize_error unknown_employee).
    One employee can have several accounts (old and new emails, tenants of
    several companies); they all count as the same person (BR-25).
    Unit of an account = employees.org_unit_id (and project_ids) for a person,
    otherwise subjects.org_unit_id, otherwise Unknown unit.
    Holder moved (BR-25) is computed: an open seat on an account whose
    employee now belongs to another P&L than the license owner, or on an email
    the employee no longer uses.
  '''
}
Table license_assignments {
  id bigint [pk, increment]
  license_plan_id bigint [not null, ref: > license_plans.id]
  subject_id bigint [not null, ref: > subjects.id]
  assigned_on date [note: 'Assigned date reported by the provider; NULL = Unknown, then created_at counts']
  ended_on date [note: 'NULL = currently assigned']
  last_active_at timestamptz [note: 'Last recorded activity; NULL = no activity recorded. Only filled from a per-holder usage source']
  sync_run_id bigint [not null, ref: > sync_runs.id, note: 'Connector run that last wrote the row']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (license_plan_id, ended_on)
    subject_id
    last_active_at
  }

  checks {
    `ended_on is null or assigned_on is null or ended_on >= assigned_on` [name: 'chk_license_assignments_dates']
  }

  Note: '''
    A holder of a license: "Assigned" data read from the connector; ELMS never
    assigns or revokes (BR-01). An ended assignment keeps its row.
    Partial unique: one open assignment per plan and subject
    (unique on license_plan_id, subject_id where ended_on is null).
    App rule: the subject belongs to the connector of the plan
    (subjects.connector_id = license_plans.connector_id).
    Seat status (BR-03, D31) is computed, not stored, for an open assignment,
    on the data date D. L = the license (license_plans), T =
    inactivity_threshold_days (30), G = new_seat_grace_days (30), held =
    D - (assigned_on, or created_at when unknown):
      Not monitored = L.usage_granularity is NULL or aggregate
      Active        = last_active_at within the last T days, or held < G days
                      and never used (grace period)
      Inactive      = last_active_at older than T days
      No activity   = last_active_at is null and held >= G days
    A shared or service account (subjects.holder_type) is judged as a whole
    account the same way: used by anyone in the last T days = Active (BR-26).
    Usage frequency (BR-32), computed, without bands: days used = sum of
    active_days usage_records of the subject and plan over the period, shown
    against working days = Monday to Friday without public holidays from the
    later of the period start and assigned_on; Not tracked when
    L.has_daily_activity is not true.
    Detection (UC05) flags Inactive and No activity only when the day D of
    the connector is complete (D8) and L.monitoring_since is at least T days old.
    Unassigned = purchased quantity minus open assignments.
  '''
}
Table usage_records {
  id bigint [pk, increment]
  license_plan_id bigint [not null, ref: > license_plans.id]
  subject_id bigint [ref: > subjects.id, note: 'NULL = aggregate figure for the whole plan']
  metric usage_metric [not null]
  period_start date [not null]
  period_end date [not null, note: 'Inclusive']
  quantity numeric(20,4) [not null]
  sync_run_id bigint [not null, ref: > sync_runs.id, note: 'Connector run that last wrote the row']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (license_plan_id, subject_id, metric, period_start, period_end) [unique, name: 'uq_usage_records_period']
    (license_plan_id, metric, period_start)
    subject_id
  }

  checks {
    `period_end >= period_start` [name: 'chk_usage_records_period']
    `quantity >= 0` [name: 'chk_usage_records_quantity']
    `metric <> 'active_subjects' or subject_id is null` [name: 'chk_usage_records_active_subjects_aggregate']
    `metric <> 'active_days' or (subject_id is not null and quantity <= period_end - period_start + 1)` [name: 'chk_usage_records_active_days']
    `metric not in ('active_subjects', 'active_days', 'peak_concurrent') or quantity = trunc(quantity)` [name: 'chk_usage_records_whole_counts']
  }

  Note: '''
    Usage per period for Concurrent, Metered, and Capacity plans, aggregate
    activity for Allocation plans without per-user data, and the active days of
    each holder for days used (active_days, BR-32). The last activity of
    a seat lives in license_assignments.last_active_at.
    A sync of the same period replaces the row (A3, BR-33): the unique index
    must be created with NULLS NOT DISTINCT so it also holds for aggregate rows,
    where subject_id is NULL.
    App rule: one period length per plan and metric (the period of
    the source, usually a day or a month) and no overlapping periods, so sums
    over periods never count a day twice. The metric matches the archetype of
    the plan (see the enum notes). The subject, when set, belongs to the
    connector of the plan.
    Metered overuse (D13) = sum of consumption over the validity of a line
    with a quota, compared with that quota.
    A missing period is Unknown, never 0 (BR-04).
  '''
}

Table plan_daily_snapshots {
  id bigint [pk, increment]
  snapshot_date date [not null]
  license_plan_id bigint [not null, ref: > license_plans.id]
  purchased_qty numeric(20,4) [note: 'Sum of the entitlement lines active that day; NULL = Unknown (one active line Unknown makes the sum Unknown), or unlimited']
  is_unlimited boolean [not null, default: false, note: 'True when a pay_as_you_go PO line of the plan is active that day: there is no quota and purchased_qty is NULL']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (snapshot_date, license_plan_id) [unique, name: 'uq_plan_daily_snapshots_date_plan']
    license_plan_id
  }

  checks {
    `not is_unlimited or purchased_qty is null` [name: 'chk_plan_daily_snapshots_unlimited']
  }

  Note: '''
    Daily Purchased quantity per plan, kept by ELMS
    because a re-import or an edit overwrites the quantity of a PO line, so
    past days cannot be recomputed from entitlement_lines. Feeds the
    License List (UC01), trends, and the
    seat basis of cost_allocations. Purchased in money is the accrual (D33).
    Rows are frozen once written; a later correction changes only new days
    (D9).
    Assigned and Used are not stored here, so each figure has one owner:
    seat counts are the sum over units of plan_unit_daily_snapshots; peak,
    consumption, and deployed units of non-seat plans are in usage_records.
    No row or a NULL column = Unknown for that day.
  '''
}

Table plan_unit_daily_snapshots {
  id bigint [pk, increment]
  snapshot_date date [not null]
  license_plan_id bigint [not null, ref: > license_plans.id]
  org_unit_id bigint [ref: > org_units.id, note: 'Unit of the holders that day, at any level; NULL = Unknown unit']
  active_qty numeric(20,4) [not null, note: 'Seats Active (grace period included), as shares: a holder on two projects counts 0.5 in each (D39)']
  inactive_qty numeric(20,4) [not null]
  no_activity_qty numeric(20,4) [not null]
  not_monitored_qty numeric(20,4) [not null]
  shared_service_qty numeric(20,4) [not null, note: 'Of the four above: seats of shared and service accounts, listed apart (BR-26)']
  used_qty numeric(20,4) [note: 'Metered plans: consumption attributed to the unit; NULL = Unknown']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (snapshot_date, license_plan_id, org_unit_id) [unique, name: 'uq_plan_unit_daily_snapshots']
    (license_plan_id, snapshot_date)
    (org_unit_id, snapshot_date)
  }

  checks {
    `active_qty >= 0 and inactive_qty >= 0 and no_activity_qty >= 0 and not_monitored_qty >= 0` [name: 'chk_plan_unit_daily_snapshots_counts']
    `shared_service_qty between 0 and active_qty + inactive_qty + no_activity_qty + not_monitored_qty` [name: 'chk_plan_unit_daily_snapshots_shared']
  }

  Note: '''
    Daily seat status per license and unit: every assigned seat has one status
    (BR-03), so Assigned is the sum of active, inactive, no activity, and not
    monitored. Seats are shares: a holder on several projects counts toward
    each in equal parts (BR-06, D39), so the units still add up (BR-19).
    shared_service_qty is the part held by shared and service accounts, judged
    as whole accounts and listed apart (BR-26). The unit is the one of that
    day, so history keeps it after an employee moves (D9, BR-25).
    The rows of every day of a month are the seat basis of the month (D44):
    cost_allocations splits each day's share of the accrued cost with them
    into Used (active), Wasted (inactive + no activity, plus the unassigned
    seats of the owner), and Not evaluated (not monitored) (BR-22). The seat
    counts shown for a month are those of its last day (BR-03).
    The unique index needs NULLS NOT DISTINCT because org_unit_id may be NULL.
    Rows are written only for a day of the connector that is complete
    (D8); counts have no default, so a missing day is no row, never a row of
    zeros.
  '''
}
Table employee_app_usage {
  id bigint [pk, increment]
  employee_id bigint [not null, ref: > employees.id, note: 'Employee BCA reports, matched by employee code, otherwise by email']
  application_name varchar(200) [not null, note: 'Application as BCA names it']
  usage_date date [not null, note: 'The day the application was used']
  active_minutes int [note: 'Minutes the application was in use that day (UC03); NULL = Unknown']
  product_id bigint [ref: > software_products.id, note: 'Catalog software the application maps to, set by the mapping of UC02; NULL = not mapped']
  sync_run_id bigint [not null, ref: > sync_runs.id, note: 'BCA run that wrote the row']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, application_name, usage_date) [unique, name: 'uq_employee_app_usage_day']
    usage_date
    product_id
  }

  checks {
    `active_minutes is null or active_minutes >= 0` [name: 'chk_employee_app_usage_minutes']
  }

  Note: '''
    Employee usage of applications on company machines, from BCA (BR-21, D36):
    kept in its own table, separate from the license usage tables, so later
    services and functions can use it. Read by UC03, by the days used of UC01
    when the license has no usage of its own, and only by the Managers of the
    employee's units (BR-14).
    One row = one employee used one application on one day. Days used in a
    period = the number of rows; last used = the latest usage_date.
    A member with no machine reporting to BCA has no row: "Not tracked",
    never "not used" (BR-04). BCA reports per day the domain account of the user, which
    carries the ILVG employee code, and each application with its active
    minutes, the machines of one person added together; ELMS matches the
    employee by code, otherwise by email. A person not in ILVG is rejected
    (raw_records.normalize_error unknown_employee). A sync of the same day
    replaces the row (BR-33).
  '''
}
// ----------------------------------------------------------------------------
// 5. Budget, cost, and expenses (UC03, UC04, UC07, Usage screen)
// ----------------------------------------------------------------------------

Table budget_plan_lines {
  id bigint [pk, increment]
  import_batch_id bigint [not null, ref: > import_batches.id, note: 'Budget import (version) that wrote the line']
  org_unit_id bigint [not null, ref: > org_units.id, note: 'Deepest unit the line names (group, P&L, block, department, project), inside the target subtree. A shared license is planned per P&L; a group line plans its free seats (BR-24)']
  license_name varchar(200) [not null, note: 'License as written in the file']
  license_plan_id bigint [ref: > license_plans.id, note: 'License the name matches (see the note); NULL = Not mapped (UC04)']
  month date [not null, note: 'First day of the month planned']
  planned_quantity numeric(20,4) [not null]
  planned_amount numeric(18,2) [not null]
  currency char(3) [not null]
  superseded_by_import_id bigint [ref: > import_batches.id, note: 'Budget import that replaced or removed the line; NULL = in force. When: its confirmed_at']

  indexes {
    (import_batch_id, org_unit_id, license_name, month) [unique, name: 'uq_budget_plan_lines_version_row']
    (org_unit_id, month)
    license_plan_id
  }

  checks {
    `planned_quantity >= 0` [name: 'chk_budget_plan_lines_quantity']
    `planned_amount >= 0` [name: 'chk_budget_plan_lines_amount']
    `extract(day from month) = 1` [name: 'chk_budget_plan_lines_month_start']
    `superseded_by_import_id is null or superseded_by_import_id <> import_batch_id` [name: 'chk_budget_plan_lines_superseded']
  }

  Note: '''
    The Plan figure (BR-09): one line per unit, license, and month, in
    quantity and amount, with source budget_excel (BR-12). A line belongs to
    the deepest unit it names, so a unit's Plan = its own lines + the Plan of
    the units under it and no line is counted twice (BR-08, BR-19).
    A plan is judged where it is set (BR-34): a license planned at a unit above
    the one being viewed is shown there as "Planned at <unit>" and left out of
    its variance.
    Partial unique: one line in force per unit, license, and month
    (unique on org_unit_id, lower(license_name), month where
    superseded_by_import_id is null). The migration makes the version-row index
    case-insensitive too (lower(license_name)), so a file with "M365 E3" and
    "m365 e3" for the same unit and month is rejected in the preview.
    Shared licenses (BR-24): the Manager of the group plans one line per P&L
    that uses the license, or deeper, so each P&L's Plan includes its share
    and is compared with its charge-back; a group line plans the seats the
    group keeps free. P&L Managers can then change or add the lines of their
    units. The file has no Shared column (D51): a line plans a share when its
    license is a shared one.
    Mapping to license_plan_id, among active licenses that are not
    duplicates, by lower(coalesce(sap_name, external_name)): the licenses
    owned by the P&L of org_unit_id (none for a group line) and the licenses
    owned by the group. No match -> Not mapped; more than one -> the row is
    rejected in the preview, until Staff give one of them another sap_name
    (UC02).
    App rule: confirming an import supersedes, in the same transaction, only
    the lines in force of its scope that it replaces or removes, then inserts
    the added and replaced lines (D42, BR-33). A line of the group unit is a
    shared line.
  '''
}
Table cost_allocations {
  id bigint [pk, increment]
  accounting_period_id bigint [not null, ref: > accounting_periods.id, note: 'Month of the owner unit of the license when the month was computed; a closed month keeps it after an owner change (D46)']
  license_plan_id bigint [not null, ref: > license_plans.id]
  bucket cost_bucket [not null]
  org_unit_id bigint [not null, ref: > org_units.id, note: 'unit: the unit of the holders; unallocated and unknown_unit: the owner unit of the license']
  method allocation_method [not null]
  basis_qty numeric(20,4) [note: 'Average seats of the bucket over the month = seat-days / days in the month (per_seat), or its consumption (per_usage); NULL for direct and none']
  filled_days int [note: 'per_seat: days of the month without complete seat data that took the seats of the nearest complete day of the month (D44); 0 = every day had its own data; NULL for the other methods']
  used_amount numeric(18,2) [note: 'Part of the share for Active seats or consumption (BR-22). The share of Purchased = used + wasted + not evaluated; all three NULL = Unknown']
  wasted_amount numeric(18,2) [note: 'Part for Inactive and No activity seats; all of an unallocated row (BR-22)']
  not_evaluated_amount numeric(18,2) [note: 'Part for Not monitored seats and Unknown data (BR-04)']
  computed_at timestamptz [not null, default: `now()`]

  indexes {
    (accounting_period_id, license_plan_id, bucket, org_unit_id) [unique, name: 'uq_cost_allocations_period_plan_bucket_unit']
    (org_unit_id, accounting_period_id)
    license_plan_id
  }

  checks {
    `basis_qty is null or basis_qty >= 0` [name: 'chk_cost_allocations_basis']
    `((method = 'per_seat') = (filled_days is not null)) and (filled_days is null or filled_days between 0 and 31)` [name: 'chk_cost_allocations_filled_days']
    `(used_amount is null) = (wasted_amount is null) and (wasted_amount is null) = (not_evaluated_amount is null)` [name: 'chk_cost_allocations_unknown']
    `bucket <> 'unallocated' or used_amount is null or used_amount = 0` [name: 'chk_cost_allocations_unallocated_unused']
  }

  Note: '''
    Purchased, Used, Wasted, and Not evaluated of a license for one month,
    split to units (UC07, BR-06, BR-09, BR-22, D32). Source of the Usage
    screen, the waste analysis, the financial dashboard, and variance.
    Cost of the month = the accrual of the invoices of the license for that
    month (expenses.accrual_schedule, D33).
    Split, by method:
      per_seat   day by day (seat-days, D44): each day carries cost / days in
                 the month, split over max(Purchased quantity, assigned
                 seats) of that day: each unit its held seats of that day
                 (plan_unit_daily_snapshots), unknown_unit the unplaced
                 holders, unallocated the unassigned seats under the owner
                 (the group for a shared license, BR-24) - none when more
                 seats are assigned than purchased (BR-31). A day without
                 complete seat data takes the rows of the nearest complete
                 day of the same month (the earlier one on a tie), counted in
                 filled_days. The cost of a day whose Purchased quantity is
                 Unknown goes to the unallocated row as Not evaluated (BR-04).
      per_usage  by the consumption of subjects with a known unit; the rest is
                 unknown_unit
      direct     an expense that names a unit goes to that unit
      none       no complete seat data in the whole month: one unallocated
                 row, all Not evaluated
    The share of a row (Purchased) = used_amount + wasted_amount +
    not_evaluated_amount; it is not stored on its own.
    The rows of a license and month add up to its cost (UC07 result), and the
    units add up the hierarchy (BR-19). Charge-back of a shared license is the
    unit rows of the companies that hold its seats (BR-24).
    Rows of an open month are recomputed daily. Closing the month computes
    them once more in the same transaction; rows of a closed month are never
    recomputed (D9).
  '''
}
Table expenses {
  id bigint [pk, increment]
  expense_date date [not null, note: 'Invoice date; decides the closed month and the exchange rate (BR-05, BR-10)']
  service_from date [note: 'First day of the period the invoice pays for; NULL = the term of its PO line, or the month of expense_date without one (D33)']
  service_to date [note: 'Last day of that period, inclusive']
  amount numeric(18,2) [not null, note: 'Negative only for a credit note or a correcting entry']
  currency char(3) [not null]
  license_plan_id bigint [not null, ref: > license_plans.id, note: 'License of the PO line, or the license a hand entry names']
  entitlement_line_id bigint [ref: > entitlement_lines.id, note: 'PO line the invoice pays (BR-10); NULL only for a hand entry without PO']
  org_unit_id bigint [not null, ref: > org_units.id, note: 'Company that pays the invoice; it does not follow a later owner change (BR-10, D46)']
  description text
  invoice_file_id bigint [ref: > files.id]
  accrual_schedule jsonb [note: 'Monthly spread of the amount over the period, e.g. {"2026-01": 10000000, ...}; months of closed periods are frozen (BR-23, UC04)']
  external_ref varchar(200) [note: 'Invoice number and line in SAP, e.g. 5105600123/1: the key a re-import updates (BR-33). NULL for a hand entry']
  import_batch_id bigint [ref: > import_batches.id, note: 'SAP import that last wrote the invoice; NULL for a hand entry']
  created_by bigint [ref: > user_accounts.id, note: 'Staff who entered a hand entry; NULL for an imported invoice']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    expense_date
    (license_plan_id, service_from)
    (org_unit_id, expense_date)
    entitlement_line_id
  }

  checks {
    `amount <> 0` [name: 'chk_expenses_amount_not_zero']
    `(service_from is null) = (service_to is null)` [name: 'chk_expenses_service_pair']
    `service_to is null or service_to >= service_from` [name: 'chk_expenses_service_term']
    `(import_batch_id is null) = (created_by is not null)` [name: 'chk_expenses_provenance']
    `(import_batch_id is not null) = (external_ref is not null)` [name: 'chk_expenses_invoice_ref']
    `import_batch_id is null or entitlement_line_id is not null` [name: 'chk_expenses_po_line']
  }

  Note: '''
    Invoices (UC04, BR-10, D50): from the SAP purchase file, each paying a PO
    line, or entered by hand by Staff for a purchase made outside SAP, with or
    without a PO line. The billed view (D5), and the cost the accrual
    spreads, so the source of Purchased (D33). Amounts are converted to VND
    with the rate in force on expense_date (BR-05).
    Accrual (UC04, BR-23): the amount is spread over the months of
    service_from..service_to, or else of the term of its PO line, by days for
    a month the period starts or ends in; monthly amounts are rounded to the
    thousand VND and the difference goes to the last month, so the schedule
    always adds up to the amount. A cost change in the middle of the term
    (top-up, downgrade) is a new invoice from the change; a closed month is
    never respread, its difference goes to the next open month.
    A PO line without an invoice yet leaves its months with Purchased in money
    Unknown (BR-04); its seats still count in Purchased quantity.
    Partial unique: one row per invoice line of a company (unique on
    org_unit_id, external_ref where external_ref is not null), so a re-import
    updates the row instead of adding one (BR-33).
    App rule: license_plan_id is the license of entitlement_line_id when it is
    set; an invoice is editable until its month is closed (accounting_periods
    of its company); afterwards only a correcting entry is allowed, dated in
    an open month.
  '''
}
Table accounting_periods {
  id bigint [pk, increment]
  org_unit_id bigint [not null, ref: > org_units.id, note: 'Company whose month it is: a P&L, or the group for shared licenses']
  month date [not null, note: 'First day of the month; its calendar year is also the fiscal year (D47)']
  closed_at timestamptz [note: 'NULL = open, figures Provisional (BR-28); set = closed']
  closed_by bigint [ref: > user_accounts.id, note: 'NULL when closed by the system job']

  indexes {
    (org_unit_id, month) [unique, name: 'uq_accounting_periods_unit_month']
  }

  checks {
    `extract(day from month) = 1` [name: 'chk_accounting_periods_month_start']
  }

  Note: '''
    Months of each company and whether they are closed (UC04). A closed month
    locks its invoices (expenses, BR-10), freezes its accrual and cost_allocations (D9),
    and removes the Provisional mark of its figures (BR-28).
    Closing: Staff close the month of their company after reviewing the
    accrual (UC04); otherwise a system job closes month M on month_close_day
    of M+1 (D14). A closed month is never reopened; later changes are
    correcting entries.
    A P&L month shows Provisional while it is open, and also while the group
    month of a shared license charged to the P&L is still open (D46, BR-28).
    App rule: org_unit_id is a P&L or the group.
  '''
}
Table exchange_rates {
  id bigint [pk, increment]
  from_currency char(3) [not null, note: 'Any currency but the reporting currency']
  rate numeric(18,8) [not null, note: '1 from_currency = rate units of the reporting currency']
  effective_from date [not null]
  declared_by bigint [ref: > user_accounts.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (from_currency, effective_from) [unique, name: 'uq_exchange_rates_currency_date']
  }

  checks {
    `rate > 0` [name: 'chk_exchange_rates_rate']
  }

  Note: '''
    Exchange rates entered by group-level Staff (UC04, BR-05, D12), always
    toward the reporting currency. An amount is converted with the rate in
    force on its invoice date.
    The rate of a day = the row with the latest effective_from on or before that
    day. Without a rate, converted figures are Unknown and amounts are shown per
    currency, never added (UC07).
    A corrected rate changes only figures not yet frozen; frozen snapshots and
    cost_allocations of closed months keep the rate they were computed with.
  '''
}

// ----------------------------------------------------------------------------
// 6. Optimization (UC05, UC06, UC07)
// ----------------------------------------------------------------------------

Table detection_runs {
  id bigint [pk, increment]
  data_date date [not null, note: 'Date of the data the run evaluated']
  rule_version varchar(20) [not null, note: 'Version of the detection rules, thresholds included (30 days inactive, 30 days grace, BR-03), e.g. 2026.11; a threshold change is a new version, so old results stay explainable']
  status run_status [not null, default: 'running']
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  indexes {
    data_date
  }

  checks {
    `(status = 'running') = (finished_at is null)` [name: 'chk_detection_runs_finished']
    `status <> 'paused'` [name: 'chk_detection_runs_status']
  }

  Note: 'One daily detection run (BR-11). A re-run for the same data date adds a new run; screens read the latest successful run.'
}

Table detection_results {
  id bigint [pk, increment]
  detection_run_id bigint [not null, ref: > detection_runs.id]
  license_plan_id bigint [not null, ref: > license_plans.id]
  org_unit_id bigint [ref: > org_units.id, note: 'Unit the result belongs to (D10). NULL only for inactive or leaver seats of holders with Unknown unit']
  check_type detection_check [not null]
  flagged_qty numeric(20,4) [note: 'Unassigned seats, inactive seats, or seats allocated above purchased. NULL = not evaluated; 0 = clear; more than 0 = flagged']
  monthly_cost numeric(18,2) [note: 'Monthly cost of the flagged quantity, in the reporting currency; NULL = Unknown']
  flagged_since date [note: 'First day of the current unbroken flagged streak']

  indexes {
    (detection_run_id, license_plan_id, check_type, org_unit_id) [unique, name: 'uq_detection_results_run_plan_check_unit']
    check_type
    license_plan_id
    org_unit_id
  }

  checks {
    `check_type in ('inactive', 'leaver') or org_unit_id is not null` [name: 'chk_detection_results_unit']
    `flagged_qty is null or flagged_qty >= 0` [name: 'chk_detection_results_flagged_qty']
    `(coalesce(flagged_qty, 0) > 0) = (flagged_since is not null)` [name: 'chk_detection_results_since']
  }

  Note: '''
    Result of one check for one license and unit in one run: only the
    verdict is stored (flagged quantity, its monthly cost, since when). Not
    evaluated, clear, and flagged are read from flagged_qty: NULL, 0, more
    than 0. A result shows its evidence, its cost, and the data date (BR-11).
    Unit of a result (D10):
      unused   one row for the owner unit of the license (unassigned seats sit
               in Unallocated of the owner, BR-06)
      overuse  one row for the owner unit
      inactive one row per unit of the holders; NULL = Unknown unit
      leaver   same as inactive (D20)
    Leaver check (D20): open seats whose employee has a left_on before the
    data date.
    A seat flagged as leaver is not counted again in inactive.
    Shared and service accounts (BR-26) are judged as whole accounts and
    listed apart in UC05, never as an inactive person.
    Manager data scope (BR-14): a Manager sees the rows of their units, plus the
    Unknown-unit rows of the licenses their units own.
    Lists and dashboards read the same rows, so figures tie across screens
    (UC05, UC07). Not evaluated (flagged_qty NULL) when the connector day of
    the data date is not complete (D8) or the figures needed are Unknown.
    The figures shown beside a result are read from their owner table for the
    data date of the run, never copied here:
      Purchased               = plan_daily_snapshots.purchased_qty
      Assigned, seat statuses = plan_unit_daily_snapshots
      Peak, deployed units    = usage_records
      Unassigned, Excess      = flagged_qty
    The per-seat list of UC05 is the current list of license_assignments: it
    is shown for the latest run only; older runs keep their counts, not names.
    The unique index needs NULLS NOT DISTINCT because org_unit_id may be NULL.
  '''
}

// ----------------------------------------------------------------------------
// 7. Audit (BR-12, BR-13)
// ----------------------------------------------------------------------------

Table audit_logs {
  id bigint [pk, increment]
  actor_id bigint [ref: > user_accounts.id, note: 'NULL for system jobs']
  action varchar(50) [not null, note: 'create, update, deactivate, activate, status_change, role_change, permission_change, import ...']
  entity_type varchar(60) [not null, note: 'Table name of the changed row']
  entity_id bigint [not null, note: 'id of the changed row; every table has a single-column id']
  old_values jsonb
  new_values jsonb
  reason text [note: 'Required where a rule asks for one: permission change (UC08), unit correction (UC09)']
  correlation_id varchar(64) [note: 'Request id, or sync_run / job id for system changes']
  ip_address varchar(45)
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, occurred_at)
    (actor_id, occurred_at)
    occurred_at
  }

  Note: '''
    Append-only record of who changed what, with old value, new value, and time
    (BR-13): connectors (create, edit, pause, resume), budget imports,
    catalog mappings, shared-license marks, expenses, users, units, roles,
    and permissions. The application database role has INSERT
    and SELECT only on this table, so rows cannot be updated or deleted.
  '''
}

Table data_overrides {
  id bigint [pk, increment]
  org_unit_id bigint [not null, ref: > org_units.id, note: 'The corrected unit (UC09)']
  field_name varchar(60) [not null, note: 'The corrected field, e.g. parent_id']
  original_value text [note: 'Value from the connector; refreshed by each sync']
  override_value text [not null]
  reason text [not null]
  overridden_by bigint [not null, ref: > user_accounts.id]
  overridden_at timestamptz [not null, default: `now()`]
  reverted_at timestamptz [note: 'NULL = the override is in force']

  indexes {
    (org_unit_id, field_name)
  }

  Note: '''
    Admin correction of a value that came from ILVG (UC09): a unit placed
    under the wrong parent, with a reason; the original value is kept beside
    it. While an override is in force, an ILVG sync updates original_value here
    and leaves the corrected column. Licenses, holders, and usage are never
    overridden: they are corrected at the source (BR-01).
    Values are text in one format: numbers as plain decimals, dates as ISO 8601.
    Partial unique: one override in force per field
    (unique on org_unit_id, field_name where reverted_at is null).
    App rule: the sync and an Admin edit lock the edited row (SELECT ... FOR
    UPDATE) so neither overwrites the other.
  '''
}

// ----------------------------------------------------------------------------
// Table groups
// ----------------------------------------------------------------------------

TableGroup organization_and_access {
  org_units
  employees
  roles
  permissions
  role_permissions
  user_accounts
  user_sessions
  user_org_units
}

TableGroup license_catalog {
  vendors
  software_categories
  software_products
  license_plans
  entitlement_lines
}

TableGroup collection_pipeline {
  connectors
  sync_runs
  raw_records
  files
  import_batches
}

TableGroup holders_and_usage {
  subjects
  license_assignments
  usage_records
  plan_daily_snapshots
  plan_unit_daily_snapshots
  employee_app_usage
}

TableGroup budget_and_expenses {
  budget_plan_lines
  cost_allocations
  expenses
  accounting_periods
  exchange_rates
}

TableGroup optimization {
  detection_runs
  detection_results
}

TableGroup audit {
  audit_logs
  data_overrides
}

  org_units
  employees
  roles
  permissions
  role_permissions
  user_accounts
  user_sessions
  manager_org_units
}

TableGroup license_catalog {
  vendors
  software_categories
  software_products
  product_links
  license_plans
  contracts
  entitlement_lines
  entitlement_allocations
}

TableGroup collection_pipeline {
  connectors
  plan_data_sources
  sync_runs
  collection_coverage
  raw_records
  files
  import_batches
}

TableGroup holders_and_usage {
  subjects
  license_assignments
